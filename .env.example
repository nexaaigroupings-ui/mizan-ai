# Mizan AI Environment Variables
# Copy this file to .env and update the values

# Server Port
PORT=3000

# JWT Secret (change this to a strong random value in production)
JWT_SECRET=change-this-to-a-strong-random-secret-key-12345

# Database Path (for production on Railway, use /data/mizan.db)
DATABASE_PATH=./data/mizan.db

# Node Environment
NODE_ENV=development

# Railway Specific (optional)
RAILWAY_ENVIRONMENT_NAME=production
